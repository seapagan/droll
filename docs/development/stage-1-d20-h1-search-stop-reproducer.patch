+/// Returns the fixed 32-candidate-per-region d20 grid.
+#[must_use]
+pub fn d20_launch_search_candidates() -> Vec<D20LaunchCandidate> {
+    let mut candidates = Vec::with_capacity(96);
+    for kind in [
+        D20LaunchKind::HighEndOverEnd,
+        D20LaunchKind::LateralAxial,
+        D20LaunchKind::DiagonalCompound,
+    ] {
+        let (base, axes) = d20_prototype(kind);
+        for height_delta in [-0.12, 0.12] {
+            for yaw_delta in [0.0, 0.31] {
+                for linear_scale in [0.94, 1.06] {
+                    for angular_scale in [0.94, 1.06] {
+                        for axis in axes {
+                            let mut state = base;
+                            state.position.y += height_delta * D20_FACE_TO_FACE;
+                            state.orientation =
+                                Quat::from_rotation_y(yaw_delta) * state.orientation;
+                            state.linear_velocity *= linear_scale;
+                            state.angular_velocity =
+                                axis * (base.angular_velocity.length() * angular_scale);
+                            candidates.push(D20LaunchCandidate {
+                                search_id: u8::try_from(candidates.len())
+                                    .expect("search cap is 96"),
+                                kind,
+                                state,
+                            });
+                        }
+                    }
+                }
+            }
+        }
+    }
+    candidates
+}
+
+fn apply_d20_orientation(state: &mut D20LaunchState, axis: Vec3, degrees: f32) {
+    state.orientation =
+        Quat::from_axis_angle(axis.normalize(), degrees.to_radians()) * state.orientation;
+}
+
+fn d20_prototype(kind: D20LaunchKind) -> (D20LaunchState, [Vec3; 2]) {
+    let (position, euler, linear, rotations, time, axes) = match kind {
+        D20LaunchKind::HighEndOverEnd => (
+            Vec3::new(-1.55, 3.55, -0.85),
+            Vec3::new(0.7, 0.25, 1.0),
+            Vec3::new(2.65, 0.35, 1.15),
+            1.45,
+            0.72,
+            [
+                Vec3::new(0.94, 0.18, 0.29).normalize(),
+                Vec3::new(0.86, 0.32, 0.40).normalize(),
+            ],
+        ),
+        D20LaunchKind::LateralAxial => (
+            Vec3::new(1.65, 2.75, -0.45),
+            Vec3::new(1.2, 0.65, 0.25),
+            Vec3::new(-2.25, 0.20, 1.65),
+            1.25,
+            0.64,
+            [
+                Vec3::new(0.18, 0.96, 0.24).normalize(),
+                Vec3::new(0.34, 0.89, 0.30).normalize(),
+            ],
+        ),
+        D20LaunchKind::DiagonalCompound => (
+            Vec3::new(1.25, 3.25, 1.05),
+            Vec3::new(0.35, 1.0, 0.75),
+            Vec3::new(-2.35, 0.50, -1.50),
+            1.55,
+            0.78,
+            [
+                Vec3::new(0.72, -0.51, 0.47).normalize(),
+                Vec3::new(0.58, -0.63, 0.52).normalize(),
+            ],
+        ),
+    };
+    let angular_speed = d20_angular_speed(rotations, time);
+    (
+        LaunchState {
+            position: position * D20_FACE_TO_FACE,
+            orientation: Quat::from_euler(EulerRot::XYZ, euler.x, euler.y, euler.z),
+            linear_velocity: linear * D20_FACE_TO_FACE,
+            angular_velocity: axes[0] * angular_speed,
+        },
+        axes,
+    )
+}
+
+fn d20_angular_speed(rotations: f32, seconds: f32) -> f32 {
+    let collider =
+        Collider::convex_hull(d20_geometry().collider_vertices()).expect("valid d20 hull");
+    let inertia = collider
+        .mass_properties(1.0)
+        .principal_angular_inertia
+        .element_sum()
+        / 3.0;
+    let desired_speed = rotations * std::f32::consts::TAU / seconds;
+    let rotational_energy = 0.5 * inertia * desired_speed * desired_speed;
+    (2.0 * rotational_energy / inertia).sqrt()
+}
