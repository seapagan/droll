+#[derive(Default)]
+struct D20NaturalObservation {
+    stable_steps: usize,
+    stable_face: Option<u8>,
+    contact_steps: usize,
+    first_contact: Option<f32>,
+    max_linear: f32,
+    max_angular: f32,
+}
+
+fn observe_d20_natural_step(
+    app: &App,
+    die: Entity,
+    floor: Entity,
+    step: usize,
+    observation: &mut D20NaturalObservation,
+) -> Result<Option<NaturalRun>, String> {
+    let world = app.world();
+    let linear = world.get::<LinearVelocity>(die).expect("linear velocity");
+    let angular = world.get::<AngularVelocity>(die).expect("angular velocity");
+    let collisions = world
+        .get::<CollidingEntities>(die)
+        .expect("collision state");
+    let rotation = world.get::<Rotation>(die).expect("rotation").0;
+    let contact = collisions.contains(&floor);
+    observation.max_linear = observation.max_linear.max(linear.length());
+    observation.max_angular = observation.max_angular.max(angular.length());
+    if contact {
+        observation.contact_steps += 1;
+        observation
+            .first_contact
+            .get_or_insert(step as f32 * STEP_SECONDS as f32);
+    }
+    let face = d20_geometry().upward_face(rotation);
+    let stable = contact
+        && linear.length() <= 0.10
+        && angular.length() <= 0.16
+        && d20_face_is_unambiguous(rotation, face.value)
+        && observation
+            .stable_face
+            .is_none_or(|value| value == face.value);
+    if stable {
+        observation.stable_face = Some(face.value);
+        observation.stable_steps += 1;
+    } else {
+        observation.stable_face = None;
+        observation.stable_steps = 0;
+    }
+    if observation.stable_steps < D20_STABLE_STEPS {
+        return Ok(None);
+    }
+    if observation.max_linear < 2.0 || observation.max_angular < 5.0 {
+        return Err("insufficient energetic throw".to_owned());
+    }
+    Ok(Some(NaturalRun {
+        face: face.value,
+        completed_seconds: step as f32 * STEP_SECONDS as f32,
+        first_contact_seconds: observation
+            .first_contact
+            .expect("stable rest followed contact"),
+        contact_steps: observation.contact_steps,
+        max_linear_speed: observation.max_linear,
+        max_angular_speed: observation.max_angular,
+    }))
+}
+
+fn d20_face_is_unambiguous(rotation: Quat, selected_value: u8) -> bool {
+    let geometry = d20_geometry();
+    let selected = geometry.face(selected_value).expect("selected face exists");
+    let mut scores = geometry
+        .faces
+        .map(|face| (rotation * face.normal).dot(Vec3::Y));
+    scores.sort_by(f32::total_cmp);
+    let margin = scores[19] - scores[18];
+    let minimum_adjacent_angle = geometry
+        .faces
+        .iter()
+        .flat_map(|face| {
+            face.adjacent_values.map(|value| {
+                face.normal
+                    .angle_between(geometry.face(value).expect("adjacent face").normal)
+            })
+        })
+        .min_by(f32::total_cmp)
+        .expect("d20 has adjacent faces");
+    let selected_angle = (rotation * selected.normal).angle_between(Vec3::Y);
+    margin > D20_ANGLE_EPSILON && selected_angle + D20_ANGLE_EPSILON < minimum_adjacent_angle / 2.0
+}
