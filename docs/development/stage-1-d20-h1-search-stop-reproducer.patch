+fn run_natural_d20(state: D20LaunchState) -> Result<NaturalRun, String> {
+    let (mut app, die, floor) = build_d20_app(state);
+    let mut observation = D20NaturalObservation::default();
+    for step in 1..=WATCHDOG_STEPS {
+        app.update();
+        if let Some(run) = observe_d20_natural_step(&app, die, floor, step, &mut observation)? {
+            return Ok(run);
+        }
+    }
+    Err("watchdog timeout".to_owned())
+}
