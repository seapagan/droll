+fn screen_d20(candidate: D20LaunchCandidate) -> Result<Vec<NaturalRun>, String> {
+    let mut runs: Vec<NaturalRun> = Vec::with_capacity(D20LaunchNuisance::ALL.len());
+    for nuisance in D20LaunchNuisance::ALL {
+        let run = run_natural_d20(nuisance.apply(candidate.state))?;
+        if let Some(nominal) = runs.first()
+            && run.face != nominal.face
+        {
+            return Err(format!(
+                "{} changed face {}->{}",
+                nuisance.as_str(),
+                nominal.face,
+                run.face
+            ));
+        }
+        runs.push(run);
+    }
+    Ok(runs)
+}
+
+fn print_d20_runs(candidate: D20LaunchCandidate, runs: &[NaturalRun]) {
