+/// The nominal state and 12 preregistered d20 perturbations.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum D20LaunchNuisance {
+    Nominal,
+    PositionXPlus,
+    PositionXMinus,
+    PositionZPlus,
+    PositionZMinus,
+    OrientationXyPlus,
+    OrientationXyMinus,
+    OrientationYzPlus,
+    OrientationYzMinus,
+    LinearPlus,
+    LinearMinus,
+    AngularPlus,
+    AngularMinus,
+}
+
+impl D20LaunchNuisance {
+    pub const ALL: [Self; 13] = [
+        Self::Nominal,
+        Self::PositionXPlus,
+        Self::PositionXMinus,
+        Self::PositionZPlus,
+        Self::PositionZMinus,
+        Self::OrientationXyPlus,
+        Self::OrientationXyMinus,
+        Self::OrientationYzPlus,
+        Self::OrientationYzMinus,
+        Self::LinearPlus,
+        Self::LinearMinus,
+        Self::AngularPlus,
+        Self::AngularMinus,
+    ];
+
+    #[must_use]
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::Nominal => "nominal",
+            Self::PositionXPlus => "position-x-plus-0.01-face-size",
+            Self::PositionXMinus => "position-x-minus-0.01-face-size",
+            Self::PositionZPlus => "position-z-plus-0.01-face-size",
+            Self::PositionZMinus => "position-z-minus-0.01-face-size",
+            Self::OrientationXyPlus => "orientation-world-xy-plus-0.5deg",
+            Self::OrientationXyMinus => "orientation-world-xy-minus-0.5deg",
+            Self::OrientationYzPlus => "orientation-world-yz-plus-0.5deg",
+            Self::OrientationYzMinus => "orientation-world-yz-minus-0.5deg",
+            Self::LinearPlus => "linear-times-1.01",
+            Self::LinearMinus => "linear-times-0.99",
+            Self::AngularPlus => "angular-times-1.01",
+            Self::AngularMinus => "angular-times-0.99",
+        }
+    }
+
+    #[must_use]
+    pub fn apply(self, mut state: D20LaunchState) -> D20LaunchState {
+        let position_delta = D20_FACE_TO_FACE * 0.01;
+        match self {
+            Self::Nominal => {}
+            Self::PositionXPlus => state.position.x += position_delta,
+            Self::PositionXMinus => state.position.x -= position_delta,
+            Self::PositionZPlus => state.position.z += position_delta,
+            Self::PositionZMinus => state.position.z -= position_delta,
+            Self::OrientationXyPlus => {
+                apply_d20_orientation(&mut state, Vec3::new(1.0, 1.0, 0.0), 0.5)
+            }
+            Self::OrientationXyMinus => {
+                apply_d20_orientation(&mut state, Vec3::new(1.0, 1.0, 0.0), -0.5)
+            }
+            Self::OrientationYzPlus => {
+                apply_d20_orientation(&mut state, Vec3::new(0.0, 1.0, 1.0), 0.5)
+            }
+            Self::OrientationYzMinus => {
+                apply_d20_orientation(&mut state, Vec3::new(0.0, 1.0, 1.0), -0.5)
+            }
+            Self::LinearPlus => state.linear_velocity *= 1.01,
+            Self::LinearMinus => state.linear_velocity *= 0.99,
+            Self::AngularPlus => state.angular_velocity *= 1.01,
+            Self::AngularMinus => state.angular_velocity *= 0.99,
+        }
+        state
+    }
+}
