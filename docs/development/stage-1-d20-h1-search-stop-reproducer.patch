+#[test]
+fn test_d20_bounded_search_finds_three_robust_energetic_families() {
+    let candidates = d20_launch_search_candidates();
+    assert_eq!(candidates.len(), 96);
+    assert_eq!(
+        candidates
+            .iter()
+            .filter(|candidate| candidate.kind == D20LaunchKind::HighEndOverEnd)
+            .count(),
+        32
+    );
+    assert_eq!(
+        candidates
+            .iter()
+            .filter(|candidate| candidate.kind == D20LaunchKind::LateralAxial)
+            .count(),
+        32
+    );
+    assert_eq!(
+        candidates
+            .iter()
+            .filter(|candidate| candidate.kind == D20LaunchKind::DiagonalCompound)
+            .count(),
+        32
+    );
+    let mut accepted = BTreeMap::new();
+    let mut rejected = Vec::new();
+    for candidate in candidates {
+        if accepted.contains_key(&candidate.kind) {
+            continue;
+        }
+        match screen_d20(candidate) {
+            Ok(runs) => {
+                println!("d20-accepted,{},base-face-{}", candidate.id(), runs[0].face);
+                print_d20_runs(candidate, &runs);
+                accepted.insert(candidate.kind, (candidate, runs));
+            }
+            Err(reason) => {
+                println!("d20-rejected,{},{}", candidate.id(), reason);
+                rejected.push((candidate.id(), reason));
+            }
+        }
+    }
+    println!(
+        "d20-search-summary,cap-96,considered-{},accepted-{},rejected-{}",
+        accepted.len() + rejected.len(),
+        accepted.len(),
+        rejected.len()
+    );
+    assert_eq!(
+        accepted.len(),
+        3,
+        "accepted={accepted:?}, rejected={rejected:?}"
+    );
+}
