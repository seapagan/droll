+        println!(
+            "d20-screen,{},{},{},{:.3},{:.3},{},{:.4},{:.4}",
+            candidate.id(),
+            nuisance.as_str(),
+            run.face,
+            run.first_contact_seconds,
+            run.completed_seconds,
+            run.contact_steps,
+            run.max_linear_speed,
+            run.max_angular_speed
+        );
+    }
+}
